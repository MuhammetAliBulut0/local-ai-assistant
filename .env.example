# Ollama sunucu adresi (yerel varsayılan)
OLLAMA_HOST=http://localhost:11434

# Sohbet için kullanılacak model (önce `ollama pull qwen2.5:7b` ile indirin)
OLLAMA_CHAT_MODEL=qwen2.5:7b

# Embedding (vektörleştirme) için kullanılacak model
# (önce `ollama pull nomic-embed-text` ile indirin)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Vektör veritabanının diskte saklanacağı klasör
CHROMA_DIR=data/chroma_db

# Chroma koleksiyon adı
CHROMA_COLLECTION=local_documents

# Yüklenen dosyaların saklanacağı klasör
UPLOAD_DIR=data/uploads

# Metin parçalama ayarları (karakter sayısı)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Bir soruda getirilecek en alakalı parça sayısı (küçük belgelerde bu sayı
# aşılıp koleksiyondaki TÜM parçalar otomatik olarak getirilir, bkz. rag_tool.py)
RETRIEVAL_K=4

# Ollama bağlam penceresi (token). Varsayılan (2048) çoğu durumda belge
# parçaları + geçmiş için yetersiz kalabildiğinden büyütüyoruz.
OLLAMA_NUM_CTX=8192
